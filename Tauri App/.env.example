# Build-time configuration for Zero Launcher.
# Copy to `.env` (git-ignored) and fill in. Values are compiled into the binary
# when you build (`./build.sh --release`, `npm run tauri dev/build`).
# Real environment variables override values in this file.

# CurseForge API key (mod search/downloads, modpacks) - https://console.curseforge.com
# NOTE: the key contains "$" characters - keep it in single quotes.
ZL_CURSEFORGE_API_KEY=

# Ely.by OAuth2 app ("Website" type, redirect URI http://127.0.0.1:38621/callback)
# https://account.ely.by/dev/applications/new
ZL_ELYBY_CLIENT_ID=
ZL_ELYBY_CLIENT_SECRET=

# Azure AD application (client) ID for Microsoft login. Optional - falls back
# to the launcher's built-in public ID.
ZL_AZURE_CLIENT_ID=

# Default Discord webhook for crash reports. Optional - leave empty to disable
# default reporting (users can still set their own in Settings).
ZL_CRASH_WEBHOOK=
